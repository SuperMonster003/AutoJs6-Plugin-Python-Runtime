    {
      "id": "source.syntax.core-grammar",
      "category": "syntax",
      "currentClaim": "VERIFIED_PORTABLE",
      "targetPhase": "R1",
      "rationale": "Representative functions, decorator, class, comprehension, pattern matching and f-string execute through the bootstrap.",
      "execution": {
        "kind": "SOURCE",
        "entryPoint": "main.py",
        "arguments": [],
        "source": "def identity(function):\n    return function\n\nclass Counter:\n    def __init__(self, values):\n        self.values = values\n\n@identity\ndef classify(counter):\n    match sum(counter.values):\n        case 14:\n            return f'ready:{len(counter.values)}'\n        case _:\n            return 'unexpected'\n\nprint(classify(Counter([value * value for value in range(1, 4)])))\n"
      },
      "expected": {
        "status": "completed",
        "exitCode": 0,
        "stdout": "ready:3\n",
        "stderr": ""
      }
    },
    {
      "id": "source.syntax.asyncio-run",
      "category": "syntax",
      "currentClaim": "VERIFIED_PORTABLE",
      "targetPhase": "R1",
      "rationale": "Async functions are supported under an ordinary asyncio.run entry, without top-level-await claims.",
      "execution": {
        "kind": "SOURCE",
        "entryPoint": "main.py",
        "arguments": [],
        "source": "import asyncio\n\nasync def answer():\n    await asyncio.sleep(0)\n    return 42\n\nprint(asyncio.run(answer()))\n"
      },
      "expected": {
        "status": "completed",
        "exitCode": 0,
        "stdout": "42\n",
        "stderr": ""
      }
    },
